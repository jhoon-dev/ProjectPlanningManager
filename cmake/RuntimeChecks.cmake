option(PPM_ENABLE_SANITIZERS "Instrument PPM with ASan and UBSan (Clang, Linux/macOS)" OFF)
option(PPM_BUILD_FUZZERS "Build Clang/libFuzzer parser tools; requires sanitizers" OFF)
if(PPM_ENABLE_SANITIZERS OR PPM_BUILD_FUZZERS)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(Clang|AppleClang)$" OR WIN32)
    message(FATAL_ERROR "PPM runtime checking requires Clang on Linux/macOS; normal Release builds need neither option")
  endif()
  if(PPM_BUILD_FUZZERS AND NOT PPM_ENABLE_SANITIZERS)
    message(FATAL_ERROR "PPM_BUILD_FUZZERS requires PPM_ENABLE_SANITIZERS=ON")
  endif()
  add_compile_options(-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
  add_link_options(-fsanitize=address,undefined -fno-sanitize-recover=all)
endif()
