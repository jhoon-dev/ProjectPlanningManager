101 ICON "@PPM_ICON_PATH@"

#include <winver.h>
1 VERSIONINFO
 FILEVERSION @PPM_WINDOWS_RESOURCE_VERSION@
 PRODUCTVERSION @PPM_WINDOWS_RESOURCE_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "ProductName", "Project Planning Manager\0"
   VALUE "FileDescription", "Project Planning Manager\0"
   VALUE "CompanyName", "Toolmoa\0"
   VALUE "Comments", "Developer: jhoon-dev; App ID: app.toolmoa.ppm\0"
   VALUE "InternalName", "PPM\0"
   VALUE "OriginalFilename", "PPM.exe\0"
   VALUE "FileVersion", "@PPM_DISPLAY_VERSION@\0"
   VALUE "ProductVersion", "@PPM_DISPLAY_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
