[Unit]
Description=PPM authenticated collaboration and interval worker
After=network.target

[Service]
Type=simple
User=ppm
Group=ppm
WorkingDirectory=/opt/ppm/server
ExecStart=/opt/ppm/venv/bin/python -m ppm_server --database /var/lib/ppm/service.sqlite serve --engine /opt/ppm/runtime/PPM-Automation --host 0.0.0.0 --port 8765 --certificate /etc/ppm/server.crt --private-key /etc/ppm/server.key --public-origin https://ppm.example.org:8765
Restart=on-failure
RestartSec=5
TimeoutStopSec=100
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ppm

[Install]
WantedBy=multi-user.target
