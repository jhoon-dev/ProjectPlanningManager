{
  "openapi": "3.1.0",
  "info": {
    "title": "PPM authenticated collaboration API",
    "version": "1.0.0",
    "description": "Bearer identity is server-issued. Native batches require stable IDs/revision and server version. SQLite is authoritative; native files are explicitly imported/exported. Only task name/duration are editable remotely."
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/login": {
      "post": {
        "summary": "Create opaque bearer session",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Malformed request"
          },
          "401": {
            "description": "Session missing/expired/revoked"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "Version conflict or request ID reuse"
          },
          "410": {
            "description": "Preview expired"
          },
          "422": {
            "description": "Native validation rejected"
          },
          "429": {
            "description": "Limit exceeded"
          },
          "503": {
            "description": "Engine timeout"
          }
        },
        "parameters": [],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        }
      }
    },
