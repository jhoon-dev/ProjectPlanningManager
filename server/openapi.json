  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque random session"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "durationMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5000000
          }
        },
        "anyOf": [
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "durationMinutes"
            ]
          }
        ]
      },
      "NativeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "documentId",
          "revision",
          "requestId",
          "operations"
        ],
        "properties": {
          "format": {
            "const": "PPM-AUTOMATION-1"
          },
          "documentId": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "At most 200 UTF-8 bytes; no NUL or line breaks"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/Operation"
            }
          }
        }
      },
      "Batch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedVersion",
          "request"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "request": {
            "$ref": "#/components/schemas/NativeRequest"
          }
        }
      },
      "Apply": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previewId"
        ],
        "properties": {
          "previewId": {
            "type": "string"
          }
        }
      },
      "Grant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "userId",
          "role"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "role": {
            "enum": [
              "editor",
              "reviewer",
              "viewer",
              null
            ]
          }
        }
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "intervalSeconds",
          "startAt",
          "expectedVersion",
          "request"
        ],
        "properties": {
          "projectId": {
            "type": "string"
          },
          "intervalSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 2592000
          },
          "startAt": {
            "type": "integer",
            "description": "Unix seconds UTC",
            "minimum": 0,
            "maximum": 4102444800
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "request": {
            "$ref": "#/components/schemas/NativeRequest"
          }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "password"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256
          }
        }
      },
      "AccountState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
